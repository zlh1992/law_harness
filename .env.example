# 当前已验证的 Codex 订阅桥接模式
# 仅由启动脚本映射为 DSH_PROXY_TOKEN；DSH 本身不允许该受保护变量出现在 .env 中。
LAW_PROXY_TOKEN=请替换为随机高强度口令
PROXY_HOST=127.0.0.1
PROXY_PORT=4010
CODEX_MODEL=gpt-5.6-sol
PUBLIC_MODEL_PROVIDER=openai
PUBLIC_MODEL_ID=gpt-5.6-sol
MAX_CONCURRENCY=1
CODEX_TIMEOUT_MS=300000
MAX_BODY_BYTES=33554432

# Local Memory 的 native SQLite 依赖应使用 Node.js 22 或 24 LTS；留空时使用 PATH 中的 node。
MEMORY_NODE_BIN=

# 公网入口只通过本地登录网关与 HTTPS 隧道暴露 Harness，切勿复用代理口令。
PUBLIC_GATEWAY_HOST=127.0.0.1
PUBLIC_GATEWAY_PORT=4180
PUBLIC_ACCESS_PASSWORD=请替换为随机高强度口令
PUBLIC_WORKSPACE_ID=请填入预注册法务工作区ID
PUBLIC_SESSION_TTL_SECONDS=43200
PUBLIC_COOKIE_SECURE=true
PUBLIC_UPLOAD_MAX_BYTES=26214400
PUBLIC_UPLOAD_SESSION_MAX_BYTES=262144000
# 留空时使用项目内 workspaces/session-files；Harness 与公网网关必须指向同一目录。
PUBLIC_UPLOAD_ROOT=

# 稳定公网地址（可选）：在 Cloudflare 创建命名隧道和 Published application，
# 将固定域名映射到 http://localhost:4180，再把隧道 token 单独保存到下列文件（权限 600）。
# 默认 quick 会继续生成临时网址；自有域名改为 named；免费固定 *.ts.net 地址改为 tailscale。
PUBLIC_TUNNEL_MODE=quick
PUBLIC_URL=
PUBLIC_TUNNEL_TOKEN_FILE=.data/cloudflare-tunnel.token
CLOUDFLARED_PROTOCOL=auto
TAILSCALE_BIN=/usr/local/bin/tailscale

# DS4 模式（单独使用，不与上面代理同时占用同一端口）
DS4_DIR=$HOME/src/ds4
DS4_MODEL_PATH=$HOME/src/ds4/ds4flash.gguf
DS4_HOST=127.0.0.1
DS4_PORT=8000
DS4_CTX=100000
DS4_KV_DIR=$HOME/Library/Caches/ds4-kv
DS4_KV_SPACE_MB=8192
DS4_GATEWAY_TOKEN=请替换为网关随机口令
